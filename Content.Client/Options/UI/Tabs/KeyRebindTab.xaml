<Control xmlns="https://spacestation14.io"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="KeybindsContainer" Orientation="Vertical" Margin="8" SeparationOverride="8">

                <!-- Keybind sections are added here in the C# code -->

            </BoxContainer>
        </ScrollContainer>
        <BoxContainer Margin="8 0 8 8">
            <ui:OptionRow Title="{Loc 'ui-options-binds-reset-all'}"
                          Description="{Loc 'ui-options-binds-explanation'}"
                          HorizontalExpand="True">
                <Button Name="ResetAllButton"
                        Text="{Loc 'ui-options-binds-reset-all'}"
                        HorizontalAlignment="Right" />
            </ui:OptionRow>
        </BoxContainer>
    </BoxContainer>
</Control>
