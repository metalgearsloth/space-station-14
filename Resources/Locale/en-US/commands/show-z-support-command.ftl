cmd-showzsupport-desc = Toggles projected z-level support diagnostics.
cmd-showzsupport-help = Usage: {$command}. Use zphysics_debug <entity> on the server for candidates and rejection reasons.
cmd-showzsupport-status = Set projected support debug overlay to {$status}.

cmd-zfall_latency-desc = Toggles fixed client input latency for manually inspecting authoritative fall handoffs.
cmd-zfall_latency-help = Usage: {$command} [seconds|off]. With no argument, toggles 350 ms latency.
cmd-zfall_latency-status = Z-level fall inspection latency: {$latency} seconds one-way on client input.

z-level-portal-blocked = You can't move there, the way is blocked.
